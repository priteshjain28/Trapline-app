# Every setting the site app needs, with no values. Copy to .env.local (ignored by git) or set them where noted.
# You create these accounts and keys yourself; nothing here is shared with the original app.

# ---------------------------------------------------------------- Android app build (public values)
# Supabase > Project Settings > API. The anon key is public by design; row level security protects the data.
# Set as environment variables before `gradle :app:assembleRelease`, or as site.supabaseUrl / site.supabaseAnonKey
# in ~/.gradle/gradle.properties. Leave empty to build the demo (sample data, code 123456).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------- Edge Function secrets (server only)
# Set with: supabase secrets set --env-file .env.local
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.

# MSG91 (SMS in India). Templates must be DLT-approved before they deliver.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_INVITE_TEMPLATE_ID=

# Supabase Auth > Hooks > Send SMS hook: the secret Supabase shows you (starts with v1,whsec_)
SEND_SMS_HOOK_SECRET=

# Razorpay (test mode keys until launch: rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids from Razorpay > Subscriptions > Plans
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_PRO_PLUS=
RAZORPAY_PLAN_ADVANCED=

# Firebase Cloud Messaging: the whole service-account JSON on one line
FCM_SERVICE_ACCOUNT=

# Random strings you generate (e.g. `openssl rand -hex 32`)
PUSH_WEBHOOK_SECRET=
CRON_SECRET=

# Where invite SMS sends people (your Play Store listing or landing page)
APP_LINK=
