-- The phone's copy of the data it needs. Screens read only from here; SyncEngine keeps it in step with Supabase.
-- Dates are ISO yyyy-MM-dd text, instants ISO-8601 text, money integer paise. Column names follow the server.

CREATE TABLE person (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  phone TEXT,
  email TEXT
);

CREATE TABLE project (
  id TEXT NOT NULL PRIMARY KEY,
  org_id TEXT NOT NULL,
  name TEXT NOT NULL,
  status TEXT NOT NULL,
  address TEXT,
  start_date TEXT,
  end_date TEXT,
  progress_pct REAL NOT NULL DEFAULT 0,
  shift_hours REAL NOT NULL DEFAULT 8,
  attendance_remarks INTEGER NOT NULL DEFAULT 1,
  image_path TEXT,
  image_local TEXT
);

CREATE TABLE task (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  number INTEGER,
  name TEXT NOT NULL,
  category TEXT NOT NULL,
  unit TEXT,
  planned_qty REAL,
  done_qty REAL NOT NULL DEFAULT 0,
  progress_pct REAL NOT NULL DEFAULT 0,
  start_date TEXT,
  due_date TEXT,
  assignee_id TEXT,
  status TEXT NOT NULL,
  work_order_id TEXT
);
CREATE INDEX task_project ON task(project_id);

CREATE TABLE task_category (
  id TEXT NOT NULL PRIMARY KEY,
  org_id TEXT NOT NULL,
  name TEXT NOT NULL
);

CREATE TABLE task_update (
  id TEXT NOT NULL PRIMARY KEY,
  task_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  author_id TEXT,
  work_date TEXT NOT NULL,
  qty_done REAL,
  progress_pct REAL,
  remarks TEXT,
  created_at TEXT NOT NULL
);
CREATE INDEX task_update_task ON task_update(task_id);
CREATE INDEX task_update_project_day ON task_update(project_id, work_date);

-- Photos on an update. local_uri until uploaded; storage_path once the server has it.
CREATE TABLE media (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  task_update_id TEXT,
  local_uri TEXT,
  storage_path TEXT,
  taken_at TEXT NOT NULL,
  album_id TEXT,
  uploaded_by TEXT
);
CREATE INDEX media_update ON media(task_update_id);
CREATE INDEX media_project ON media(project_id, taken_at);

CREATE TABLE album (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  name TEXT NOT NULL
);

CREATE TABLE worker (
  id TEXT NOT NULL PRIMARY KEY,
  org_id TEXT NOT NULL,
  project_id TEXT NOT NULL,
  name TEXT NOT NULL,
  skill TEXT,
  phone TEXT,
  wage_type TEXT NOT NULL,
  wage_paise INTEGER NOT NULL,
  ot_rate_paise INTEGER NOT NULL,
  active INTEGER NOT NULL DEFAULT 1
);
CREATE INDEX worker_project ON worker(project_id);

-- One record per worker per day: phones merge on this key, like the server.
CREATE TABLE attendance (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  worker_id TEXT NOT NULL,
  work_date TEXT NOT NULL,
  status TEXT NOT NULL,
  ot_hours REAL NOT NULL DEFAULT 0,
  remarks TEXT,
  UNIQUE (project_id, worker_id, work_date)
);

CREATE TABLE report (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  type TEXT NOT NULL,
  from_date TEXT NOT NULL,
  to_date TEXT NOT NULL,
  parts TEXT NOT NULL,
  status TEXT NOT NULL,
  storage_path TEXT,
  local_file TEXT,
  created_at TEXT NOT NULL,
  expires_at TEXT NOT NULL
);

CREATE TABLE activity (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  actor_id TEXT,
  verb TEXT NOT NULL,
  entity_id TEXT,
  summary TEXT NOT NULL,
  created_at TEXT NOT NULL
);
CREATE INDEX activity_project ON activity(project_id, created_at);

-- People and roles. Owners and admins of the company manage every site.
CREATE TABLE org_member (
  id TEXT NOT NULL PRIMARY KEY,
  org_id TEXT NOT NULL,
  user_id TEXT NOT NULL,
  role TEXT NOT NULL
);

CREATE TABLE project_member (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  user_id TEXT NOT NULL,
  role TEXT NOT NULL
);
CREATE INDEX project_member_project ON project_member(project_id);

CREATE TABLE invite (
  id TEXT NOT NULL PRIMARY KEY,
  org_id TEXT NOT NULL,
  project_id TEXT,
  phone TEXT NOT NULL,
  project_role TEXT,
  accepted_at TEXT,
  created_at TEXT NOT NULL
);

CREATE TABLE issue (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  number INTEGER,
  task_id TEXT,
  title TEXT NOT NULL,
  description TEXT,
  due_date TEXT,
  assignee_id TEXT,
  status TEXT NOT NULL,
  raised_by TEXT,
  created_at TEXT NOT NULL,
  closed_at TEXT
);
CREATE INDEX issue_project ON issue(project_id);

CREATE TABLE comment (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  issue_id TEXT,
  task_id TEXT,
  author_id TEXT,
  body TEXT NOT NULL,
  created_at TEXT NOT NULL
);
CREATE INDEX comment_issue ON comment(issue_id);

-- Material. Stock is never stored: it is the sum of these rows, like the server's stock_movements ledger.
CREATE TABLE material (
  id TEXT NOT NULL PRIMARY KEY,
  org_id TEXT NOT NULL,
  name TEXT NOT NULL,
  spec TEXT NOT NULL DEFAULT '',
  uom TEXT NOT NULL,
  category TEXT
);

CREATE TABLE grn (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  number INTEGER,
  received_on TEXT NOT NULL,
  challan_no TEXT,
  notes TEXT,
  received_by TEXT,
  created_at TEXT NOT NULL
);
CREATE INDEX grn_project ON grn(project_id);

CREATE TABLE grn_line (
  id TEXT NOT NULL PRIMARY KEY,
  grn_id TEXT NOT NULL,
  material_id TEXT NOT NULL,
  qty REAL NOT NULL
);
CREATE INDEX grn_line_grn ON grn_line(grn_id);

CREATE TABLE material_issue (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  number INTEGER,
  task_id TEXT,
  subcontractor_id TEXT,
  issued_on TEXT NOT NULL,
  issued_by TEXT,
  created_at TEXT NOT NULL
);
CREATE INDEX material_issue_project ON material_issue(project_id);

CREATE TABLE material_issue_line (
  id TEXT NOT NULL PRIMARY KEY,
  material_issue_id TEXT NOT NULL,
  material_id TEXT NOT NULL,
  qty REAL NOT NULL
);
CREATE INDEX material_issue_line_issue ON material_issue_line(material_issue_id);

-- kind: opening | consumption | correction (server names); qty signed
CREATE TABLE stock_adjustment (
  id TEXT NOT NULL PRIMARY KEY,
  project_id TEXT NOT NULL,
  subcontractor_id TEXT,
  material_id TEXT NOT NULL,
  kind TEXT NOT NULL,
  qty REAL NOT NULL,
  task_id TEXT,
  adjusted_on TEXT NOT NULL,
  note TEXT,
  created_at TEXT NOT NULL
);
CREATE INDEX stock_adjustment_project ON stock_adjustment(project_id);

-- Changes made here, waiting to go to the server, oldest first.
CREATE TABLE outbox (
  seq INTEGER PRIMARY KEY AUTOINCREMENT,
  table_name TEXT NOT NULL,
  row_id TEXT NOT NULL,
  op TEXT NOT NULL,            -- upsert | delete | upload
  payload TEXT NOT NULL,       -- JSON body (upsert), filter (delete), or upload descriptor
  on_conflict TEXT,            -- natural key for upserts that merge (attendance)
  attempts INTEGER NOT NULL DEFAULT 0,
  last_error TEXT
);
CREATE INDEX outbox_row ON outbox(table_name, row_id);

-- Small things to remember between launches (the signed-in session's profile and organisation).
CREATE TABLE kv (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

CREATE TABLE sync_cursor (
  table_name TEXT NOT NULL PRIMARY KEY,
  cursor TEXT NOT NULL
);

-- ---------------------------------------------------------------- people

upsertPerson:
INSERT OR REPLACE INTO person VALUES ?;
person:
SELECT * FROM person WHERE id = ?;
people:
SELECT * FROM person;

-- ---------------------------------------------------------------- projects

upsertProject:
INSERT OR REPLACE INTO project VALUES ?;
projects:
SELECT * FROM project ORDER BY CASE status WHEN 'active' THEN 0 WHEN 'on_hold' THEN 1 WHEN 'completed' THEN 2 ELSE 3 END, lower(name);
project:
SELECT * FROM project WHERE id = ?;
projectIds:
SELECT id FROM project;
setProjectImage:
UPDATE project SET image_path = ?, image_local = ? WHERE id = ?;
updateSettings:
UPDATE project SET shift_hours = ?, attendance_remarks = ? WHERE id = ?;
updateProjectProgress:
UPDATE project SET progress_pct = (SELECT coalesce(avg(progress_pct), 0) FROM task WHERE task.project_id = project.id) WHERE id = ?;
deleteProject:
DELETE FROM project WHERE id = ?;

-- ---------------------------------------------------------------- tasks

upsertTask:
INSERT OR REPLACE INTO task VALUES ?;
tasks:
SELECT * FROM task WHERE project_id = ? ORDER BY number IS NULL DESC, number DESC;
task:
SELECT * FROM task WHERE id = ?;
updateTaskProgress:
UPDATE task SET done_qty = ?, progress_pct = ?, status = ? WHERE id = ?;
deleteTask:
DELETE FROM task WHERE id = ?;

upsertCategory:
INSERT OR REPLACE INTO task_category VALUES ?;
categoryNames:
SELECT name FROM task_category;
taskCategoryNames:
SELECT DISTINCT category FROM task;
deleteCategory:
DELETE FROM task_category WHERE id = ?;

upsertUpdate:
INSERT OR REPLACE INTO task_update VALUES ?;
updatesForTask:
SELECT * FROM task_update WHERE task_id = ? ORDER BY work_date DESC, created_at DESC;
updatesInRange:
SELECT * FROM task_update WHERE project_id = ? AND work_date BETWEEN ? AND ? ORDER BY created_at;
deleteUpdate:
DELETE FROM task_update WHERE id = ?;

upsertMedia:
INSERT OR REPLACE INTO media VALUES ?;
mediaForUpdate:
SELECT * FROM media WHERE task_update_id = ? ORDER BY taken_at;
mediaForProject:
SELECT * FROM media WHERE project_id = ?;
photos:
SELECT m.id, m.project_id, m.local_uri, m.storage_path, m.taken_at, m.album_id, m.uploaded_by, u.task_id
FROM media m LEFT JOIN task_update u ON u.id = m.task_update_id
WHERE m.project_id = ?
ORDER BY m.taken_at DESC;
mediaOne:
SELECT * FROM media WHERE id = ?;
setMediaAlbum:
UPDATE media SET album_id = ? WHERE id = ?;

upsertAlbum:
INSERT OR REPLACE INTO album VALUES ?;
album:
SELECT * FROM album WHERE id = ?;
albums:
SELECT * FROM album WHERE project_id = ? ORDER BY lower(name);
deleteAlbum:
DELETE FROM album WHERE id = ?;

setMediaStoragePath:
UPDATE media SET storage_path = ? WHERE id = ?;
deleteMedia:
DELETE FROM media WHERE id = ?;

-- ---------------------------------------------------------------- workers and attendance

upsertWorker:
INSERT OR REPLACE INTO worker VALUES ?;
workers:
SELECT * FROM worker WHERE project_id = ? AND active = 1 ORDER BY lower(name);
deleteWorker:
DELETE FROM worker WHERE id = ?;

upsertAttendance:
INSERT OR REPLACE INTO attendance VALUES ?;
attendanceOn:
SELECT * FROM attendance WHERE project_id = ? AND work_date = ?;
attendanceBetween:
SELECT * FROM attendance WHERE project_id = ? AND work_date BETWEEN ? AND ?;
attendanceOne:
SELECT * FROM attendance WHERE project_id = ? AND worker_id = ? AND work_date = ?;
clearAttendance:
DELETE FROM attendance WHERE project_id = ? AND worker_id = ? AND work_date = ?;
deleteAttendance:
DELETE FROM attendance WHERE id = ?;

-- ---------------------------------------------------------------- reports and feed

upsertReport:
INSERT OR REPLACE INTO report VALUES ?;
reports:
SELECT * FROM report WHERE project_id = ? AND expires_at > ? ORDER BY created_at DESC;
report:
SELECT * FROM report WHERE id = ?;
setReportFile:
UPDATE report SET status = ?, storage_path = ?, local_file = ? WHERE id = ?;
deleteReport:
DELETE FROM report WHERE id = ?;

upsertActivity:
INSERT OR REPLACE INTO activity VALUES ?;
activity:
SELECT * FROM activity WHERE project_id = ? ORDER BY created_at DESC;
deleteActivity:
DELETE FROM activity WHERE id = ?;

-- ---------------------------------------------------------------- team

upsertOrgMember:
INSERT OR REPLACE INTO org_member VALUES ?;
orgMembers:
SELECT * FROM org_member WHERE org_id = ?;
deleteOrgMember:
DELETE FROM org_member WHERE id = ?;

upsertProjectMember:
INSERT OR REPLACE INTO project_member VALUES ?;
projectMembers:
SELECT * FROM project_member WHERE project_id = ?;
projectMemberOne:
SELECT * FROM project_member WHERE project_id = ? AND user_id = ?;
setProjectMemberRole:
UPDATE project_member SET role = ? WHERE id = ?;
deleteProjectMember:
DELETE FROM project_member WHERE id = ?;

upsertInvite:
INSERT OR REPLACE INTO invite VALUES ?;
pendingInvites:
SELECT * FROM invite WHERE project_id = ? AND accepted_at IS NULL ORDER BY created_at DESC;
deleteInvite:
DELETE FROM invite WHERE id = ?;

-- ---------------------------------------------------------------- issues

upsertIssueRow:
INSERT OR REPLACE INTO issue VALUES ?;
siteIssues:
SELECT i.*, (SELECT count(*) FROM comment c WHERE c.issue_id = i.id) AS comment_count
FROM issue i WHERE i.project_id = ? ORDER BY i.created_at DESC;
siteIssue:
SELECT i.*, (SELECT count(*) FROM comment c WHERE c.issue_id = i.id) AS comment_count FROM issue i WHERE i.id = ?;
setIssueStatus:
UPDATE issue SET status = ?, closed_at = ? WHERE id = ?;
openIssueCounts:
SELECT task_id, count(*) AS open_count FROM issue WHERE project_id = ? AND status = 'open' AND task_id IS NOT NULL GROUP BY task_id;
deleteIssueRow:
DELETE FROM issue WHERE id = ?;

upsertComment:
INSERT OR REPLACE INTO comment VALUES ?;
commentsFor:
SELECT * FROM comment WHERE issue_id = ? ORDER BY created_at;
deleteComment:
DELETE FROM comment WHERE id = ?;

-- ---------------------------------------------------------------- material

upsertMaterial:
INSERT OR REPLACE INTO material VALUES ?;
material:
SELECT * FROM material WHERE id = ?;
catalogue:
SELECT * FROM material ORDER BY lower(name), lower(spec);
deleteMaterial:
DELETE FROM material WHERE id = ?;

upsertGrn:
INSERT OR REPLACE INTO grn VALUES ?;
grns:
SELECT * FROM grn WHERE project_id = ? ORDER BY received_on DESC, created_at DESC;
grnLines:
SELECT * FROM grn_line WHERE grn_id = ?;
deleteGrn:
DELETE FROM grn WHERE id = ?;
upsertGrnLine:
INSERT OR REPLACE INTO grn_line VALUES ?;
deleteGrnLine:
DELETE FROM grn_line WHERE id = ?;

upsertIssue:
INSERT OR REPLACE INTO material_issue VALUES ?;
issues:
SELECT * FROM material_issue WHERE project_id = ? ORDER BY issued_on DESC, created_at DESC;
issueLines:
SELECT * FROM material_issue_line WHERE material_issue_id = ?;
deleteIssue:
DELETE FROM material_issue WHERE id = ?;
upsertIssueLine:
INSERT OR REPLACE INTO material_issue_line VALUES ?;
deleteIssueLine:
DELETE FROM material_issue_line WHERE id = ?;

upsertAdjustment:
INSERT OR REPLACE INTO stock_adjustment VALUES ?;
deleteAdjustment:
DELETE FROM stock_adjustment WHERE id = ?;

-- Every stock movement of the site's own inventory: + in, - out. Issues reduce site stock whoever they go to.
movements:
SELECT entry_id, material_id, kind, qty, day, number, task_id, note, created_at FROM (
  SELECT l.id AS entry_id, l.material_id AS material_id, 'received' AS kind, l.qty AS qty, g.received_on AS day, g.number AS number,
         NULL AS task_id, g.challan_no AS note, g.created_at AS created_at
  FROM grn_line l JOIN grn g ON g.id = l.grn_id WHERE g.project_id = :projectId
  UNION ALL
  SELECT l.id, l.material_id, 'issued', -l.qty, i.issued_on, i.number, i.task_id, NULL, i.created_at
  FROM material_issue_line l JOIN material_issue i ON i.id = l.material_issue_id WHERE i.project_id = :projectId
  UNION ALL
  SELECT a.id, a.material_id, a.kind, a.qty, a.adjusted_on, NULL, a.task_id, a.note, a.created_at
  FROM stock_adjustment a WHERE a.project_id = :projectId AND a.subcontractor_id IS NULL
)
ORDER BY day DESC, created_at DESC;

-- ---------------------------------------------------------------- outbox and cursors

enqueue:
INSERT INTO outbox (table_name, row_id, op, payload, on_conflict) VALUES (?, ?, ?, ?, ?);
nextOutbox:
SELECT * FROM outbox ORDER BY seq LIMIT ?;
pendingFor:
SELECT count(*) FROM outbox WHERE table_name = ? AND row_id = ?;
pendingCount:
SELECT count(*) FROM outbox;
failedCount:
SELECT count(*) FROM outbox WHERE attempts > 0;
doneOutbox:
DELETE FROM outbox WHERE seq = ?;
failOutbox:
UPDATE outbox SET attempts = attempts + 1, last_error = ? WHERE seq = ?;

kvGet:
SELECT value FROM kv WHERE key = ?;
kvPut:
INSERT OR REPLACE INTO kv VALUES (?, ?);
kvDelete:
DELETE FROM kv WHERE key = ?;

cursorFor:
SELECT cursor FROM sync_cursor WHERE table_name = ?;
setCursor:
INSERT OR REPLACE INTO sync_cursor VALUES (?, ?);

wipe {
  DELETE FROM person;
  DELETE FROM project;
  DELETE FROM task;
  DELETE FROM task_update;
  DELETE FROM media;
  DELETE FROM album;
  DELETE FROM issue;
  DELETE FROM comment;
  DELETE FROM task_category;
  DELETE FROM org_member;
  DELETE FROM project_member;
  DELETE FROM invite;
  DELETE FROM worker;
  DELETE FROM attendance;
  DELETE FROM report;
  DELETE FROM activity;
  DELETE FROM material;
  DELETE FROM grn;
  DELETE FROM grn_line;
  DELETE FROM material_issue;
  DELETE FROM material_issue_line;
  DELETE FROM stock_adjustment;
  DELETE FROM outbox;
  DELETE FROM sync_cursor;
  DELETE FROM kv;
}
